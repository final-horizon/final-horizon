<DefaultWindow xmlns="https://spacestation14.io" Title="{Loc 'ghost-target-window-title'}" MinSize="500 200" SetSize="500 500"> <!-- This whole file was changed by FH -->
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SizeFlagsStretchRatio="0.4">
        <LineEdit Name="SearchBar" PlaceHolder="Search" HorizontalExpand="True" Margin="0 4" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
            <Button Name="SortNameButton" Text="Name ▲" HorizontalExpand="True" ClipText="True" SizeFlagsStretchRatio="2" />
            <Button Name="SortJobButton" Text="Job ▲" HorizontalExpand="True" ClipText="True" SizeFlagsStretchRatio="1" />
            <Button Name="SortDepartmentButton" Text="Department ▲" HorizontalExpand="True" ClipText="True" SizeFlagsStretchRatio="1" />
            <Button Name="SortMobStateButton" Text="Mob State ▲" HorizontalExpand="True" ClipText="True" SizeFlagsStretchRatio="1" />
            <Button Name="RefreshButton" Text="Refresh" HorizontalExpand="True" ClipText="True" SizeFlagsStretchRatio="1" />
        </BoxContainer>
        <ScrollContainer Name="GhostScroll" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="ButtonContainer" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" SeparationOverride="5">
                <!-- Target buttons get added here by code -->
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
